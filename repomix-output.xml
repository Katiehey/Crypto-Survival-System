            'mean': df['volume'].mean(),
            'median': df['volume'].median(),
            'current': df['volume'].iloc[-1] if len(df) > 0 else None,
            'current_ratio': df['volume_ratio'].iloc[-1] if 'volume_ratio' in df.columns and len(df) > 0 else None,
