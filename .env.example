# =============================================================================
# EXCHANGE CONFIGURATION
# Copy this file to .env and fill in your values. Never commit .env.
# =============================================================================

# Exchange: "kucoin" or "binance"
EXCHANGE=kucoin

# KuCoin API credentials (required if EXCHANGE=kucoin)
KUCOIN_API_KEY=your_kucoin_api_key
KUCOIN_API_SECRET=your_kucoin_api_secret
KUCOIN_API_PASSPHRASE=your_kucoin_api_passphrase

# Binance API credentials (required if EXCHANGE=binance)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_TESTNET=false

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================

# "paper" = simulated fills against live prices (safe to start)
# "live"  = real orders — only after extensive paper testing
TRADING_MODE=paper

TRADING_PAIR=BTC/USDT
BASE_CURRENCY=USDT
STARTING_CAPITAL=30

# =============================================================================
# RISK LIMITS
# =============================================================================

MAX_RISK_PER_TRADE=0.005        # 0.5% of balance per trade
MAX_DAILY_LOSS=0.01             # Stop trading if down 1% on the day
MAX_CONSECUTIVE_LOSSES=2        # Trigger cooldown after N losses
MAX_TRADES_PER_DAY=2            # Hard cap on daily trades
MAX_DRAWDOWN_KILL_SWITCH=0.25   # Engage kill switch at 25% drawdown
COOLDOWN_MINUTES=15

ATR_STOP_MULT=1.98              # Stop loss = entry ± N×ATR
ATR_TARGET_MULT=2.23            # Take profit = entry ± N×ATR

# =============================================================================
# STRATEGY PARAMETERS (tunable via optimize.py)
# =============================================================================

ADX_TREND_THRESHOLD=34.7
RSI_TREND_BUY_MIN=52.4
RSI_RANGE_BUY_MAX=30.0
VOLUME_SPIKE_MIN=1.2

# =============================================================================
# NOTIFICATIONS
# =============================================================================

# Telegram — get a bot token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_ENABLED=true

# Optional email alerts (Gmail app password)
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_RECIPIENT=your_email@gmail.com

# =============================================================================
# SYSTEM
# =============================================================================

LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90
DATA_UPDATE_INTERVAL=60
MIN_CANDLES_REQUIRED=100
