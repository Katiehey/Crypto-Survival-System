# =============================================================================
# BINANCE API CONFIGURATION
# =============================================================================
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# CRITICAL: Enable "Spot & Margin Trading" ONLY (NO withdrawals)

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Set to 'true' for testnet, 'false' for live trading
# ALWAYS start with testnet
BINANCE_TESTNET=true

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# Trading mode: 'paper' (simulated) or 'live' (real money)
# NEVER set to 'live' without extensive paper trading first
TRADING_MODE=paper

# Starting capital in USDT
STARTING_CAPITAL=500

# Trading pair (Binance format)
TRADING_PAIR=BTC/USDT
BASE_CURRENCY=USDT

# =============================================================================
# RISK LIMITS (DO NOT MODIFY WITHOUT DOCUMENTED REVIEW)
# =============================================================================

# Maximum risk per single trade (0.005 = 0.5%)
MAX_RISK_PER_TRADE=0.005

# Maximum daily loss before system stops (0.01 = 1%)
MAX_DAILY_LOSS=0.01

# Maximum consecutive losses before cooldown
MAX_CONSECUTIVE_LOSSES=2

# Maximum trades allowed per day
MAX_TRADES_PER_DAY=2

# Maximum drawdown from peak before kill switch (0.05 = 5%)
MAX_DRAWDOWN_KILL_SWITCH=0.05

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# How many days to keep logs before rotation
LOG_RETENTION_DAYS=90

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to SQLite database (relative to project root)
DB_PATH=data/trading.db

# =============================================================================
# OPERATIONAL SETTINGS
# =============================================================================

# Data update frequency in minutes
DATA_UPDATE_INTERVAL=60

# Minimum candles required before system can trade
MIN_CANDLES_REQUIRED=100

# =============================================================================
# SAFETY NOTES
# =============================================================================
# 1. NEVER commit the actual .env file (it's in .gitignore)
# 2. NEVER share your API keys
# 3. ALWAYS test on testnet first
# 4. Enable IP whitelist on Binance for API keys
# 5. NEVER enable withdrawal permissions on API keys